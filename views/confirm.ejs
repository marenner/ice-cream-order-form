<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Ice Cream Order Form</title>

        <link rel="stylesheet" href="styles/ice-cream.css">
        <link rel="icon" href="images/ice-cream-cone-icon.webp">
    </head>
    <body>
        <h1>Thank you for your order, <%= order.name %>!</h1>
        <h2>Order Summary</h2>
        <p>
            Name: <%= order.name %>
        </p>
        <p>
            Email: <%= order.email %>
        </p>
        <p>
            Flavor: <%= order.flavor %>
        </p>
        <p>
            Cone: <%= order.cone %>
        </p>
        <p>
            Toppings: <%= order.toppings %>
        </p>
        <p>
            Comments: <%= order.comment %>
        </p>
        <p>
            Date and Time: <%= order.timestamp.toLocaleString() %>
        </p>
        <a href="/">Place Another Order</a>
        <a href="/admin">Admin</a>
    </body>
</html>