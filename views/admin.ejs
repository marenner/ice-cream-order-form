<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Admin</title>
        <link rel="icon" href="images/pizza-icon.png">          <!--Favicon-->
        <!-- Add data table resources -->
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
        <link rel="Stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
    </head>
    <body>
        <h1>Orders</h1>
        <table id="order-table" class="display">
            <thead>
                <th>Name</th>
                <th>Email</th>
                <th>Method</th>
                <th>Toppings</th>
                <th>Size</th>
                <th>Comment</th>
                <th>Date/Time</th>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td>
                            <%= order.name %>
                        </td>
                        <td>
                            <%= order.email %>
                        </td>
                        <td>
                            <%= order.flavor %>
                        </td>
                        <td>
                            <%= order.cone %>
                        </td>
                        <td>
                            <%= order.toppings %>
                        </td>
                        <td>
                            <%= order.comments %>
                        </td>
                        <td>
                            <%= order.timestamp.toLocaleString() %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <script>
            new DataTable('#order-table');
        </script>
    </body>
</html>